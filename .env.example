# Copy this file to .env.local and adjust as needed.
# Both variables are validated at startup by src/lib/config/env.ts.

# Base URL of the FastAPI backend, no trailing slash.
# Deployed: the Render URL, e.g. https://memoirproject-ai-backend.onrender.com
# NEXT_PUBLIC_* is inlined at BUILD time, so changing this needs a redeploy,
# not a restart. The backend must also list this app's origin in its
# ALLOWED_ORIGINS, or every call fails CORS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. How long a single API request may take, in milliseconds.
# Render's free tier spins down when idle and takes ~30-50s to wake, so the
# first request after a quiet spell needs a budget well past 10s.
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# --- Supabase Auth ---------------------------------------------------------
# The browser signs up and logs in against Supabase directly; the FastAPI
# backend only verifies the resulting token. Both values are public — they are
# inlined into the client bundle. Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
